# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/.vinext/
/out/
/dist/
/build/
*.tsbuildinfo

# Test and tooling caches
/coverage/
/.wrangler/
.eslintcache

# Local environment — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Distribution archives — rebuild these, do not version them.
# The image-originals archive is ~29 MB and belongs in a release asset
# or Git LFS, not in the repository history.
*.zip

# Scratch
/outputs/
/work/

# Note: .openai/hosting.json used to be excluded from this list because the old
# vite.config.ts imported it at build time. That config and that file were both
# removed when the Cloudflare/vinext stack was dropped, so there is nothing to
# keep unignored any more.

# Extracted contribution packages. The archives themselves are already
# ignored above; their unpacked contents do not belong in history either.
/are-you-sear-ious-image-originals/
/are-you-sear-ious-tri-tip-complete/

# iCloud creates byte-identical "name (2).ext" copies while syncing.
* (2).*

# Contribution packages. The text, prompts, sources and provenance JSON are
# tracked because they are the record of where each recipe came from. The
# heavy parts are not: original PNGs belong in the image-originals archive,
# and a package's own build output and font binaries are rebuildable noise.
contributions/**/original.png
contributions/_originals-first-twelve/
contributions/coffee-ancho-tri-tip/package/
contributions/**/scaffold/dist/
contributions/**/scaffold/assets/fonts/
