# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/.vinext/
/out/
/dist/
/build/
*.tsbuildinfo

# Test and tooling caches
/coverage/
/.wrangler/
.eslintcache

# Local environment — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Distribution archives — rebuild these, do not version them.
# The image-originals archive is ~29 MB and belongs in a release asset
# or Git LFS, not in the repository history.
*.zip

# Scratch
/outputs/
/work/

# Note: .openai/hosting.json is intentionally NOT ignored. vite.config.ts
# imports it at build time, so ignoring it breaks the build. It holds a Sites
# project identifier, not a credential — see NOTICE.md.
